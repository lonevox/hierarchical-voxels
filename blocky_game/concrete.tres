code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying vec3 var_world_position;

uniform sampler2D tex_frg_11;
uniform sampler2D tex_frg_5;
uniform sampler2D tex_frg_12;



void vertex() {
// Input:4
	mat4 n_out4p0 = MODEL_MATRIX;


// Input:5
	vec3 n_out5p0 = VERTEX;


	vec3 n_out3p0;
// Expression:3
	n_out3p0 = vec3(0.0, 0.0, 0.0);
	{
		n_out3p0 = (n_out4p0 * vec4(n_out5p0, 1.0)).xyz;
	}


// VaryingSetter:2
	var_world_position = n_out3p0;


}

void fragment() {
// VaryingGetter:14
	vec3 n_out14p0 = var_world_position;


// FloatConstant:3
	float n_out3p0 = 6.000000;


// UVFunc:4
	vec2 n_in4p2 = vec2(0.00000, 0.00000);
	vec2 n_out4p0 = n_in4p2 * vec2(n_out3p0) + vec2(n_out14p0.xy);


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, n_out4p0);


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, UV);


	float n_out6p0;
// Remap:6
	float n_in6p1 = 0.00000;
	float n_in6p2 = 1.00000;
	float n_in6p3 = 0.60000;
	float n_in6p4 = 1.20000;
	{
		float __input_range = n_in6p2 - n_in6p1;
		float __output_range = n_in6p4 - n_in6p3;
		n_out6p0 = n_in6p3 + __output_range * ((n_out5p0.x - n_in6p1) / __input_range);
	}


// UVFunc:8
	vec2 n_in8p2 = vec2(0.00000, 0.00000);
	vec2 n_out8p0 = n_in8p2 * vec2(n_out6p0) + n_out4p0;


// Vector2Constant:9
	vec2 n_out9p0 = vec2(0.500000, 0.500000);


// FloatOp:7
	float n_in7p1 = 360.00000;
	float n_out7p0 = n_out5p0.x * n_in7p1;


	vec2 n_out10p0;
// Expression:10
	n_out10p0 = vec2(0.0, 0.0);
	{
		n_out8p0 -= n_out9p0;
		float rotation_radians = radians(n_out7p0);
		float c = cos(rotation_radians);
		float s = sin(rotation_radians);
		n_out10p0.x = n_out8p0.x * c + n_out8p0.y * s;
		n_out10p0.y = n_out8p0.y * c - n_out8p0.x * s;
		n_out10p0 += n_out9p0;
	}


// Texture2D:12
	vec4 n_out12p0 = texture(tex_frg_12, n_out10p0);


// Mix:13
	vec3 n_in13p2 = vec3(0.50000, 0.50000, 0.50000);
	vec3 n_out13p0 = mix(vec3(n_out11p0.xyz), vec3(n_out12p0.xyz), n_in13p2);


// Output:0
	ALBEDO = n_out13p0;


}
